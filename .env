# Copy this file to ".env" (inside the backend/ folder) and fill in your values.

# Required: get a free key at https://console.groq.com/keys (no credit card needed)
GROQ_API_KEY="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"

# Optional: which Groq model to use for generation.
# See current options at https://console.groq.com/docs/models
GROQ_MODEL="openai/gpt-oss-120b"

# Optional: only needed if you want to index PRIVATE GitHub repos.
# Create one at https://github.com/settings/tokens (repo scope is enough)
GITHUB_TOKEN=""

# Optional tuning - defaults shown below work fine for most repos.
EMBEDDING_MODEL="all-MiniLM-L6-v2"
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5
MAX_FILE_SIZE_KB=500
